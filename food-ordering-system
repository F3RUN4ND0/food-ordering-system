Validación y Cálculo de Total
javascriptconst createOrder = async (req, res) => {
  // 1. Validar que todos los dishes existen
  const dishIds = dishes.map(item => item.dishId);
  const foundDishes = await Dish.find({ _id: { $in: dishIds } });
  
  if (foundDishes.length !== dishIds.length) {
    throw new ApiError(400, 'One or more dishes not found');
  }
  
  // 2. Verificar disponibilidad
  for (const item of dishes) {
    const dish = foundDishes.find(d => d._id.toString() === item.dishId);
    if (!dish.available) {
      throw new ApiError(400, `Dish "${dish.name}" not available`);
    }
  }
  
  // 3. Crear order items con price snapshot
  const orderItems = dishes.map(item => {
    const dish = foundDishes.find(d => d._id.toString() === item.dishId);
    return {
      dishId: dish._id,
      quantity: item.quantity,
      price: dish.price  // ← Snapshot del precio actual
    };
  });
  
  // 4. Calcular total
  const total = orderItems.reduce((sum, item) => 
    sum + (item.price * item.quantity), 0
  );
  
  // 5. Crear orden
  const order = await Order.create({
    userId: req.user._id,
    dishes: orderItems,
    total
  });
};

Manejo de Errores Centralizado
javascript// Custom Error Class
class ApiError extends Error {
  constructor(statusCode, message, errors = null) {
    super(message);
    this.statusCode = statusCode;
    this.errors = errors;
    this.isOperational = true;
  }
}

// Global Error Handler
const errorHandler = (err, req, res, next) => {
  let statusCode = err.statusCode || 500;
  let message = err.message || 'Internal server error';
  
  // Mongoose validation errors
  if (err.name === 'ValidationError') {
    statusCode = 400;
    errors = Object.values(err.errors).map(e => ({
      field: e.path,
      message: e.message
    }));
  }
  
  // Mongoose duplicate key
  if (err.code === 11000) {
    statusCode = 400;
    message = 'Duplicate field value';
  }
  
  res.status(statusCode).json({
    success: false,
    message,
    errors
  });
};

Paginación Implementada
javascriptconst getAllDishes = async (req, res) => {
  const { page = 1, limit = 10 } = req.query;
  
  const skip = (page - 1) * limit;
  
  const dishes = await Dish.find(filter)
    .skip(skip)
    .limit(parseInt(limit));
  
  const total = await Dish.countDocuments(filter);
  
  res.json({
    success: true,
    count: dishes.length,
    pagination: {
      page: parseInt(page),
      limit: parseInt(limit),
      total,
      pages: Math.ceil(total / limit)
    },
    data: dishes
  });
};

