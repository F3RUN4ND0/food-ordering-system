Password Hashing
javascript// Pre-save hook en User model
userSchema.pre('save', async function(next) {
  if (!this.isModified('password')) return next();
  const salt = await bcrypt.genSalt(10);
  this.password = await bcrypt.hash(this.password, salt);
});

Validación con Joi
Ejemplo: Create Order Validator
javascriptconst createOrderSchema = Joi.object({
  dishes: Joi.array()
    .items(
      Joi.object({
        dishId: Joi.string()
          .regex(/^[0-9a-fA-F]{24}$/)
          .required(),
        quantity: Joi.number()
          .integer()
          .min(1)
          .required()
      })
    )
    .min(1)
    .required(),
  deliveryAddress: Joi.object({...}),
  paymentMethod: Joi.string().valid('cash', 'card', 'online')
});

